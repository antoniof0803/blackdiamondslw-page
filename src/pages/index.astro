---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";

const icons: Record<string, string> = {
  instagram: `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10m0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>`,
  tiktok: `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.6 5.82A4.99 4.99 0 0 1 19.5 5V8a7.9 7.9 0 0 1-2.9-.56v7.3A5.76 5.76 0 1 1 10.8 9v2.2a3.56 3.56 0 1 0 2.8 3.48V2h2.2c.18 1.4.9 2.7 1.8 3.82Z"/></svg>`,
  facebook: `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H7v3h3v7h3v-7h3l1-3h-4V10c0-.6.4-1 1-1z"/></svg>`,
  whatsapp: `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.15 6.4 2.15 11.84c0 1.95.53 3.76 1.46 5.34L2 22l5.01-1.56a9.86 9.86 0 0 0 5.03 1.36h.01c5.46 0 9.89-4.4 9.89-9.84C21.94 6.4 17.5 2 12.04 2m0 17.94h-.01a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.05.95.98-2.97-.2-.3a8.05 8.05 0 0 1-1.24-4.3c0-4.47 3.66-8.1 8.15-8.1 4.48 0 8.14 3.63 8.14 8.1 0 4.47-3.66 8.1-8.14 8.1m4.47-6.05c-.24-.12-1.44-.71-1.66-.79-.22-.08-.39-.12-.55.12-.16.24-.63.79-.78.95-.14.16-.29.18-.53.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.11-.49.11-.11.24-.29.36-.43.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.65.3-.22.24-.86.84-.86 2.05s.88 2.38 1 2.54c.12.16 1.74 2.66 4.22 3.73 1.56.67 2.17.73 2.95.61.48-.08 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28z"/></svg>`,
};
---

<Layout>
  <div class="page">
    <div class="backdrop" aria-hidden="true">
      <video
        class="backdrop__video"
        autoplay
        muted
        loop
        playsinline
        poster={site.background.fallbackImage}
      >
        <source src={site.background.video} type="video/mp4" />
      </video>
      <div class="backdrop__shade"></div>
    </div>

    <main class="shell">
      <header class="hero">
        <img
          class="hero__avatar"
          src={site.brand.profileImage}
          alt={site.brand.nickname}
          width="120"
          height="120"
        />
        <h1 class="hero__name">{site.brand.nickname}</h1>
        <p class="hero__bio">{site.brand.bio}</p>
        <p class="hero__location">{site.brand.location}</p>

        <nav class="social-row" aria-label="Redes sociales">
          {
            site.socials.map((item) => (
              <a
                class="social-row__link"
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
              >
                <span aria-hidden="true" set:html={icons[item.platform]} />
              </a>
            ))
          }
        </nav>
      </header>

      <section class="stack" aria-label="Acciones principales">
        <a
          class="cta cta--whatsapp"
          href={site.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="cta__icon" aria-hidden="true" set:html={icons.whatsapp} />
          <span>{site.whatsapp.label}</span>
        </a>
      </section>

      <section class="stack" aria-labelledby="locations-title">
        <h2 id="locations-title" class="section-title">{site.locations.headline}</h2>
        {
          site.locations.items.map((location) => (
            <a
              class="card card--location"
              href={location.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="card__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    fill="currentColor"
                    d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"
                  />
                </svg>
              </div>
              <div>
                <p class="card__title">{location.title}</p>
                <p class="card__subtitle">Ver en Google Maps</p>
              </div>
            </a>
          ))
        }
      </section>

      <section class="stack" aria-labelledby="services-title">
        <h2 id="services-title" class="section-title">{site.services.headline}</h2>
        <figure class="media">
          <img
            src={site.services.image}
            alt={site.services.alt}
            width="772"
            height="1000"
            loading="lazy"
          />
        </figure>
      </section>

      <section class="stack" aria-label="Síguenos">
        {
          site.socialLinks.map((link) => (
            <a
              class="cta"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="cta__icon" aria-hidden="true" set:html={icons[link.platform]} />
              <span>{link.title}</span>
            </a>
          ))
        }
      </section>
    </main>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .backdrop__video,
  .backdrop__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .backdrop__video {
    object-fit: cover;
    filter: brightness(0.45) contrast(1.05);
    animation: drift 18s ease-in-out infinite alternate;
  }

  .backdrop__shade {
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.78) 40%, rgba(0, 0, 0, 0.92)),
      radial-gradient(circle at top, rgba(251, 158, 0, 0.12), transparent 45%);
  }

  .shell {
    position: relative;
    z-index: 1;
    width: min(100%, var(--max));
    margin: 0 auto;
    padding: 2.5rem 1.1rem 3.5rem;
    display: grid;
    gap: 1.35rem;
  }

  .hero {
    text-align: center;
    animation: rise 0.7s ease both;
  }

  .hero__avatar {
    width: 118px;
    height: 118px;
    margin: 0 auto 1rem;
    border-radius: 999px;
    border: 3px solid #fff;
    object-fit: cover;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .hero__name {
    margin: 0;
    font-size: clamp(1.45rem, 5vw, 1.8rem);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .hero__bio,
  .hero__location {
    margin: 0.35rem 0 0;
    color: var(--text-muted);
    font-weight: 500;
  }

  .hero__location {
    letter-spacing: 0.18em;
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  .social-row {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 1.1rem;
  }

  .social-row__link {
    width: 2.55rem;
    height: 2.55rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .social-row__link:hover,
  .social-row__link:focus-visible {
    transform: translateY(-2px) scale(1.05);
    background: rgba(255, 255, 255, 0.16);
    outline: none;
  }

  .social-row__link :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .stack {
    display: grid;
    gap: 0.75rem;
    animation: rise 0.8s ease both;
  }

  .stack:nth-of-type(2) {
    animation-delay: 0.08s;
  }

  .stack:nth-of-type(3) {
    animation-delay: 0.14s;
  }

  .stack:nth-of-type(4) {
    animation-delay: 0.2s;
  }

  .stack:nth-of-type(5) {
    animation-delay: 0.26s;
  }

  .section-title {
    margin: 0.4rem 0 0.1rem;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .cta,
  .card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 3.55rem;
    padding: 0.95rem 1.1rem;
    border-radius: var(--radius);
    background: var(--surface-soft);
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .cta {
    justify-content: center;
    font-weight: 700;
    text-align: center;
  }

  .cta:hover,
  .cta:focus-visible,
  .card:hover,
  .card:focus-visible {
    transform: translateY(-2px);
    background: #2d2d2d;
    border-color: rgba(255, 255, 255, 0.28);
    outline: none;
  }

  .cta--whatsapp {
    background: linear-gradient(180deg, #2a2a2a, #1d1d1d);
  }

  .cta--whatsapp:hover,
  .cta--whatsapp:focus-visible {
    background: linear-gradient(180deg, #314c3a, #1f2c24);
    border-color: rgba(37, 211, 102, 0.45);
  }

  .cta__icon {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    flex: 0 0 auto;
  }

  .cta__icon :global(svg),
  .card__badge :global(svg) {
    width: 100%;
    height: 100%;
  }

  .card--location {
    background: var(--surface);
  }

  .card__badge {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    color: #f3c16b;
    flex: 0 0 auto;
  }

  .card__title {
    margin: 0;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .card__subtitle {
    margin: 0.2rem 0 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .media {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
  }

  .media img {
    width: 100%;
    height: auto;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes drift {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero,
    .stack,
    .backdrop__video {
      animation: none;
    }

    .cta,
    .card,
    .social-row__link {
      transition: none;
    }
  }
</style>
