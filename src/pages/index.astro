---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";

const icons: Record<string, string> = {
  instagram: `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2m0 7.9A3.1 3.1 0 1 1 12 8.9a3.1 3.1 0 0 1 0 6.2M17.5 6.7a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0M12 2.5c-2.5 0-2.8 0-3.8.06-1.95.09-3.6 1.7-3.7 3.66C4.45 7.2 4.45 7.5 4.45 12s0 4.8.06 5.78c.09 1.96 1.75 3.57 3.7 3.66 1 .05 1.3.06 3.8.06s2.8 0 3.8-.06c1.95-.09 3.6-1.7 3.7-3.66.05-1 .06-1.28.06-5.78s0-4.8-.06-5.78c-.09-1.96-1.75-3.57-3.7-3.66C14.8 2.5 14.5 2.5 12 2.5m0 1.53c2.45 0 2.74 0 3.7.05 1.44.07 2.65 1.28 2.72 2.72.05.97.05 1.26.05 3.7s0 2.74-.05 3.7c-.07 1.44-1.28 2.65-2.72 2.72-.97.05-1.26.05-3.7.05s-2.74 0-3.7-.05c-1.44-.07-2.65-1.28-2.72-2.72-.05-.97-.05-1.26-.05-3.7s0-2.74.05-3.7c.07-1.44 1.28-2.65 2.72-2.72.97-.05 1.26-.05 3.7-.05Z"/></svg>`,
  tiktok: `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14.7 3.2v9.05a3.85 3.85 0 1 1-3.3-3.8v2.05a1.85 1.85 0 1 0 1.35 1.78V3.2h1.95Zm2.05 0c.35 1.85 1.65 3.35 3.4 3.95v2.1a6.1 6.1 0 0 1-3.4-1.05v5.85a5.8 5.8 0 1 1-5.8-5.8h.2v2.15h-.2a3.65 3.65 0 1 0 3.65 3.65V3.2h1.95Z"/></svg>`,
  facebook: `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.1h2.4l.35-2.75h-2.75V9.4c0-.8.22-1.35 1.38-1.35H16.4V5.6A18.5 18.5 0 0 0 14.05 5c-2.32 0-3.9 1.42-3.9 4.02v2.13H7.6v2.75h2.55V21h3.35Z"/></svg>`,
  whatsapp: `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.2A9.8 9.8 0 0 0 3.55 16.7L2.2 21.8l5.25-1.38A9.8 9.8 0 1 0 12 2.2m0 17.9a8.1 8.1 0 0 1-4.12-1.13l-.3-.18-3.05.95.98-2.97-.2-.3A8.1 8.1 0 1 1 12 20.1m4.47-6.05c-.24-.12-1.44-.71-1.66-.79-.22-.08-.39-.12-.55.12s-.63.79-.78.95c-.14.16-.29.18-.53.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.11-.49.11-.11.24-.29.36-.43.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.43.06-.65.3-.22.24-.86.84-.86 2.05s.88 2.38 1 2.54c.12.16 1.74 2.66 4.22 3.73 1.56.67 2.17.73 2.95.61.48-.08 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z"/></svg>`,
};
---

<Layout>
  <div class="page">
    <div class="backdrop" aria-hidden="true">
      <video
        class="backdrop__video"
        autoplay
        muted
        loop
        playsinline
        poster={site.background.fallbackImage}
      >
        <source src={site.background.video} type="video/mp4" />
      </video>
      <div class="backdrop__shade"></div>
    </div>

    <main class="shell">
      <header class="hero">
        <img
          class="hero__avatar"
          src={site.brand.profileImage}
          alt={site.brand.nickname}
          width="120"
          height="120"
        />
        <h1 class="hero__name">{site.brand.nickname}</h1>
        <p class="hero__bio">{site.brand.bio}</p>
        <p class="hero__location">{site.brand.location}</p>

        <nav class="social-row" aria-label="Redes sociales">
          {
            site.socials.map((item) => (
              <a
                class="social-row__link"
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
              >
                <span aria-hidden="true" set:html={icons[item.platform]} />
              </a>
            ))
          }
        </nav>
      </header>

      <section class="stack" aria-label="Acciones principales">
        <a
          class="cta cta--whatsapp"
          href={site.whatsapp.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="cta__icon" aria-hidden="true" set:html={icons.whatsapp} />
          <span>{site.whatsapp.label}</span>
        </a>
      </section>

      <section class="stack" aria-labelledby="locations-title">
        <h2 id="locations-title" class="section-title">{site.locations.headline}</h2>
        {
          site.locations.items.map((location) => (
            <a
              class="card card--location"
              href={location.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="card__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    fill="currentColor"
                    d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"
                  />
                </svg>
              </div>
              <div>
                <p class="card__title">{location.title}</p>
                <p class="card__subtitle">Ver en Google Maps</p>
              </div>
            </a>
          ))
        }
      </section>

      <section class="stack" aria-labelledby="services-title">
        <h2 id="services-title" class="section-title">{site.services.headline}</h2>
        <figure class="media">
          <img
            src={site.services.image}
            alt={site.services.alt}
            width="772"
            height="1000"
            loading="lazy"
          />
        </figure>
      </section>

      <section class="stack" aria-label="Síguenos">
        {
          site.socialLinks.map((link) => (
            <a
              class="cta"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="cta__icon" aria-hidden="true" set:html={icons[link.platform]} />
              <span>{link.title}</span>
            </a>
          ))
        }
      </section>
    </main>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .backdrop__video,
  .backdrop__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .backdrop__video {
    object-fit: cover;
    filter: brightness(0.82) contrast(1.08) saturate(1.05);
    animation: drift 18s ease-in-out infinite alternate;
  }

  .backdrop__shade {
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.22), rgba(0, 0, 0, 0.38) 45%, rgba(0, 0, 0, 0.55)),
      radial-gradient(circle at top, rgba(251, 158, 0, 0.1), transparent 45%);
  }

  .shell {
    position: relative;
    z-index: 1;
    width: min(100%, var(--max));
    margin: 0 auto;
    padding: 2.5rem 1.1rem 3.5rem;
    display: grid;
    gap: 1.35rem;
  }

  .hero {
    text-align: center;
    animation: rise 0.7s ease both;
  }

  .hero__avatar {
    width: 118px;
    height: 118px;
    margin: 0 auto 1rem;
    border-radius: 999px;
    border: 3px solid #fff;
    object-fit: cover;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .hero__name {
    margin: 0;
    font-size: clamp(1.45rem, 5vw, 1.8rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #fff;
    text-shadow:
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000,
      1px 1px 0 #000,
      0 2px 6px rgba(0, 0, 0, 0.55);
  }

  .hero__bio,
  .hero__location {
    margin: 0.35rem 0 0;
    color: #fff;
    font-weight: 500;
    text-shadow:
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000,
      1px 1px 0 #000,
      0 2px 5px rgba(0, 0, 0, 0.5);
  }

  .hero__location {
    letter-spacing: 0.18em;
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  .social-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    margin: 1.1rem auto 0;
    width: fit-content;
  }

  .social-row__link {
    width: 2.55rem;
    height: 2.55rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    color: #fff;
    background: #2a2a2a;
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .social-row__link:hover,
  .social-row__link:focus-visible {
    transform: translateY(-2px) scale(1.05);
    background: #3a3a3a;
    border-color: rgba(255, 255, 255, 0.35);
    outline: none;
  }

  .social-row__link > span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.2rem;
    height: 1.2rem;
    line-height: 0;
  }

  .social-row__link :global(svg) {
    display: block;
    width: 1.2rem;
    height: 1.2rem;
    fill: #fff;
    filter: drop-shadow(0 0 1px #000) drop-shadow(0 1px 1px #000);
  }

  .stack {
    display: grid;
    gap: 0.75rem;
    animation: rise 0.8s ease both;
  }

  .stack:nth-of-type(2) {
    animation-delay: 0.08s;
  }

  .stack:nth-of-type(3) {
    animation-delay: 0.14s;
  }

  .stack:nth-of-type(4) {
    animation-delay: 0.2s;
  }

  .stack:nth-of-type(5) {
    animation-delay: 0.26s;
  }

  .section-title {
    margin: 0.4rem 0 0.1rem;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #fff;
    text-shadow:
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000,
      1px 1px 0 #000,
      0 2px 5px rgba(0, 0, 0, 0.5);
  }

  .cta,
  .card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 3.55rem;
    padding: 0.95rem 1.1rem;
    border-radius: var(--radius);
    background: #252525;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .cta {
    justify-content: center;
    font-weight: 700;
    text-align: center;
    color: #fff;
    text-shadow:
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000,
      1px 1px 0 #000;
  }

  .cta__icon :global(svg) {
    fill: #fff;
    filter: drop-shadow(0 0 1px #000) drop-shadow(0 1px 1px #000);
  }

  .cta:hover,
  .cta:focus-visible,
  .card:hover,
  .card:focus-visible {
    transform: translateY(-2px);
    background: #2d2d2d;
    border-color: rgba(255, 255, 255, 0.28);
    outline: none;
  }

  .cta--whatsapp {
    background: #1f1f1f;
  }

  .cta--whatsapp:hover,
  .cta--whatsapp:focus-visible {
    background: linear-gradient(180deg, #314c3a, #1f2c24);
    border-color: rgba(37, 211, 102, 0.45);
  }

  .cta__icon {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    flex: 0 0 auto;
  }

  .cta__icon :global(svg),
  .card__badge :global(svg) {
    width: 100%;
    height: 100%;
  }

  .card--location {
    background: #1a1a1a;
  }

  .card__badge {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: #333333;
    color: #f3c16b;
    flex: 0 0 auto;
  }

  .card__title {
    margin: 0;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #fff;
    text-shadow:
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000,
      1px 1px 0 #000;
  }

  .card__subtitle {
    margin: 0.2rem 0 0;
    color: #f0f0f0;
    font-size: 0.85rem;
    text-shadow:
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000,
      1px 1px 0 #000;
  }

  .media {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28);
  }

  .media img {
    width: 100%;
    height: auto;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes drift {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero,
    .stack,
    .backdrop__video {
      animation: none;
    }

    .cta,
    .card,
    .social-row__link {
      transition: none;
    }
  }
</style>
